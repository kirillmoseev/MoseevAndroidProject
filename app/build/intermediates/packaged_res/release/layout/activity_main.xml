<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/categories_title" />

        <Button
            android:id="@+id/btnLock"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-12dp"
            android:text="@string/button_lock"
            android:textSize="20sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvBanks"
        style="@style/Card"
        android:text="@string/category_banks" />

    <TextView
        android:id="@+id/tvMail"
        style="@style/Card"
        android:text="@string/category_mail" />

    <TextView
        android:id="@+id/tvSocial"
        style="@style/Card"
        android:text="@string/category_social" />

    <TextView
        android:id="@+id/tvOther"
        style="@style/Card"
        android:text="@string/category_other" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnGenerator"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/generator_title" />

</LinearLayout>
